{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "removeComments": true,
    "rootDir": "delta-test-tools/",
    "outDir": "dist/"
  },
  "exclude": [
    "scripts/",
    "tests/"
  ]
}
