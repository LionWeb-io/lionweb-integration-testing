{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rootDir": "client/",
    "outDir": "dist/",
    "types": ["node"]
  },
  "exclude": [
    "scripts/",
    "tests/"
  ]
}
